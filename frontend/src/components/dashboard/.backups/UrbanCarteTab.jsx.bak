import React, { useState, useEffect, useRef, useCallback, useMemo } from 'react';
import L from 'leaflet';
import 'leaflet/dist/leaflet.css';
import 'leaflet.heat';
import { MapContainer, TileLayer, Polygon, CircleMarker, Tooltip, Popup, useMap } from 'react-leaflet';
import * as turf from '@turf/turf';
import { useUrbanZone } from '../../context/UrbanZoneContext';
import { useAuth } from '../../context/AuthContext';
import { getZonesWithStats, getValidatedRemarks } from '../../services/urbanApi';
import { getCityMapConfig } from '../../utils/cityBounds';
import { unwrap } from '../../utils/unwrap';
import SkeletonTable from '../SkeletonTable.jsx';
import useResponsive from '../../hooks/useResponsive';

// ── Helpers ──────────────────────────────────────────────────────────────────

const isValidCoords = (geojson) =>
  Array.isArray(geojson) && geojson.length >= 3 &&
  geojson.every(c => Array.isArray(c) && c.length === 2 &&
    typeof c[0] === 'number' && typeof c[1] === 'number' &&
    !isNaN(c[0]) && !isNaN(c[1]));

const getCenter = (coords) => ([
  coords.reduce((s, p) => s + p[0], 0) / coords.length,
  coords.reduce((s, p) => s + p[1], 0) / coords.length,
]);

const COLOR_PALETTE = [
  '#f59e0b', '#3b82f6', '#22c55e', '#a855f7',
  '#ef4444', '#06b6d4', '#f97316', '#84cc16',
  '#ec4899', '#14b8a6',
];

const CAT_LABEL = {
  route: 'Route', eclairage: 'Éclairage', parc: 'Parc',
  ecole: 'École', hopital: 'Hôpital', autre: 'Autre',
  dechets: 'Déchets', eau: 'Eau', transport: 'Transport',
};

const getDensityColor = (count) =>
  count >= 6 ? '#ef4444' : count >= 3 ? '#f59e0b' : '#22c55e';

const getDensityLabel = (count) =>
  count >= 6 ? 'Critique' : count >= 3 ? 'Modéré' : 'Calme';

const getUrgencyColor = (avg) =>
  avg >= 4 ? '#ef4444' : avg >= 2.5 ? '#f59e0b' : '#22c55e';

const getUrgencyLabel = (avg) =>
  avg >= 4 ? 'Critique' : avg >= 2.5 ? 'Modéré' : 'Calme';

const getMonthlyTrend = (zoneId, remarks) => {
  const now = new Date();
  return [2, 1, 0].map(monthsAgo => {
    const target = new Date(now.getFullYear(), now.getMonth() - monthsAgo, 1);
    return remarks.filter(r => {
      const d = new Date(r.created_at);
      return r.zone_id === zoneId &&
        d.getMonth() === target.getMonth() &&
        d.getFullYear() === target.getFullYear();
    }).length;
  });
};

const MONTH_NAMES = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'];

const getMonthLabels = () => {
  const now = new Date();
  return [2, 1, 0].map(ago => {
    const d = new Date(now.getFullYear(), now.getMonth() - ago, 1);
    return MONTH_NAMES[d.getMonth()];
  });
};

// ── Map sub-components ───────────────────────────────────────────────────────

function MapController({ center, zoom, bounds, minZoom }) {
  const map = useMap();
  useEffect(() => {
    if (minZoom) map.setMinZoom(minZoom);
    if (bounds) map.setMaxBounds(bounds);
    if (center && zoom) map.setView(center, zoom, { animate: false });
  }, [map, center, zoom, bounds, minZoom]);
  return null;
}

function InvalidateSize() {
  const map = useMap();
  useEffect(() => {
    const timer = setTimeout(() => map.invalidateSize(), 300);
    return () => clearTimeout(timer);
  }, [map]);
  return null;
}

// ── Zone-filtered heatmap layer ──────────────────────────────────────────────

function UrbanHeatmapLayer({ zones, remarks }) {
  const map = useMap();

  const heatPoints = useMemo(() => {
    const validZones = zones.filter(z => isValidCoords(z.coordonnees_geojson));

    const reportsInsideZones = remarks.filter(report => {
      if (!report.latitude || !report.longitude) return false;
      return validZones.some(zone => {
        const point = turf.point([report.longitude, report.latitude]);
        const ring = zone.coordonnees_geojson.map(c => [c[1], c[0]]);
        const polygon = turf.polygon([ring]);
        return turf.booleanPointInPolygon(point, polygon);
      });
    });

    return reportsInsideZones.map(r => [r.latitude, r.longitude, (r.urgency || 1) / 5]);
  }, [zones, remarks]);

  useEffect(() => {
    if (!heatPoints.length) return;
    const layer = L.heatLayer(heatPoints, {
      radius: 35,
      blur: 25,
      maxZoom: 17,
      gradient: { 0.2: '#00ff00', 0.5: '#ffff00', 0.8: '#ff6600', 1.0: '#ff0000' },
    }).addTo(map);
    return () => map.removeLayer(layer);
  }, [map, heatPoints]);

  return null;
}

// ── Zone polygon with Popup ──────────────────────────────────────────────────

function ZonePolygon({ zone, isSelected, remarkCount, avgUrgency, onClick, heatmapOn, onAnalyze }) {
  if (!isValidCoords(zone.coordonnees_geojson)) return null;

  const densityColor = getDensityColor(remarkCount);

  return (
    <Polygon
      positions={zone.coordonnees_geojson}
      pathOptions={{
        color: densityColor,
        fillColor: densityColor,
        fillOpacity: heatmapOn ? 0.35 : (isSelected ? 0.4 : 0.15),
        weight: isSelected ? 2.5 : 1.5,
      }}
      eventHandlers={{
        click: () => onClick(zone),
      }}
    >
      <Tooltip sticky direction="top">
        <div style={{ fontWeight: 700, fontSize: 13 }}>{zone.nom}</div>
        <div style={{ fontSize: 11, color: '#555' }}>
          {remarkCount} signalement{remarkCount !== 1 ? 's' : ''}
        </div>
      </Tooltip>
      <Popup>
        <div style={{ fontFamily: "'DM Sans', sans-serif", minWidth: 180, padding: 2 }}>
          <div style={{ fontWeight: 700, fontSize: 14, color: '#1a1a1a', marginBottom: 4 }}>
            {zone.nom}
          </div>
          <div style={{ fontSize: 12, color: '#666', marginBottom: 10 }}>
            {remarkCount} signalement{remarkCount !== 1 ? 's' : ''} · Urgence moy. {avgUrgency}/5
          </div>
          <button
            onClick={(e) => { e.stopPropagation(); onAnalyze(zone); }}
            style={{
              background: '#C1440E', color: '#fff', border: 'none',
              padding: '7px 14px', borderRadius: '6px', fontSize: '12px',
              cursor: 'pointer', fontWeight: 600, fontFamily: "'DM Sans', sans-serif",
              width: '100%', transition: 'background 0.2s',
            }}
            onMouseEnter={e => e.currentTarget.style.background = '#A8380C'}
            onMouseLeave={e => e.currentTarget.style.background = '#C1440E'}
          >
            Voir l'analyse complète →
          </button>
        </div>
      </Popup>
    </Polygon>
  );
}

// ── Skeleton for zone panel transition ───────────────────────────────────────

function ZonePanelSkeleton() {
  const bar = (w, h) => ({
    width: w, height: h, borderRadius: 6,
    background: 'linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.07) 50%, rgba(255,255,255,0.03) 75%)',
    backgroundSize: '200% 100%',
    animation: 'ucShimmer 1.5s infinite',
  });
  return (
    <div style={{ padding: 16, display: 'flex', flexDirection: 'column', gap: 12 }}>
      <style>{`@keyframes ucShimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}`}</style>
      <div style={bar('55%', 14)} />
      <div style={bar('35%', 22)} />
      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }}>
        <div style={bar('100%', 68)} />
        <div style={bar('100%', 68)} />
      </div>
      <div style={bar('100%', 80)} />
      <div style={bar('100%', 56)} />
      <div style={bar('100%', 48)} />
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// MAIN COMPONENT
// ══════════════════════════════════════════════════════════════════════════════

export default function UrbanCarteTab({ onSwitchTab }) {
  const { user } = useAuth();
  const { setSelectedZone: setContextZone } = useUrbanZone();
  const [selectedZone, setSelectedZone] = useState(null);
  const [activeCatFilter, setActiveCatFilter] = useState(null);
  const [panelLoading, setPanelLoading] = useState(false);
  const { isMobile } = useResponsive();

  // City config
  const userCity = user?.city?.toLowerCase()?.trim() || null;
  const cityConfig = getCityMapConfig(user?.city);
  const { center: initialCenter, zoom: initialZoom, bounds: cityBounds, minZoom: cityMinZoom } = cityConfig;

  // State
  const [zones, setZones] = useState([]);
  const [remarks, setRemarks] = useState([]);
  const [loading, setLoading] = useState(true);
  const [heatmapOn, setHeatmapOn] = useState(false);
  const mapRef = useRef(null);

  // ── Data fetching ────────────────────────────────────────────────────────

  useEffect(() => {
    setLoading(true);
    Promise.all([
      getZonesWithStats(),
      getValidatedRemarks(),
    ]).then(([zRes, rRes]) => {
      const allZones = unwrap(zRes);
      const allRemarks = unwrap(rRes);

      // Filter to user's city
      const cityZones = userCity
        ? allZones.filter(z => z.ville?.toLowerCase()?.trim() === userCity)
        : allZones;

      // Deduplicate + validate coords
      const unique = cityZones
        .filter((z, i, self) => i === self.findIndex(t => t.id === z.id))
        .filter(z => isValidCoords(z.coordonnees_geojson));

      setZones(unique);
      setRemarks(allRemarks);
    }).catch(err => {
      console.error('UrbanCarteTab: data load error', err);
    }).finally(() => setLoading(false));
  }, [userCity]);

  // ── Computed data ────────────────────────────────────────────────────────

  const uniqueZones = useMemo(() =>
    zones.filter((z, i, self) => i === self.findIndex(t => t.id === z.id)),
    [zones]
  );

  // Set of valid zone IDs — only show data inside official zones
  const zoneIdSet = useMemo(() => new Set(uniqueZones.map(z => z.id)), [uniqueZones]);

  // Remarks scoped to official zones only (urbanist never sees unstructured data)
  const zonedRemarks = useMemo(() =>
    remarks.filter(r => r.zone_id && zoneIdSet.has(r.zone_id)),
    [remarks, zoneIdSet]
  );

  // Category color map from zoned remarks
  const categoryColors = useMemo(() => {
    const uniqueCats = [
      ...new Set(zonedRemarks.map(r => (r.categorie?.toLowerCase().trim() || 'autre')))
    ].sort();
    const m = {};
    uniqueCats.forEach((cat, i) => { m[cat] = COLOR_PALETTE[i % COLOR_PALETTE.length]; });
    return m;
  }, [zonedRemarks]);

  const getCatColor = useCallback((cat) => {
    if (!cat) return '#94a3b8';
    return categoryColors[cat.toLowerCase().trim()] || '#94a3b8';
  }, [categoryColors]);

  // Remark count per zone
  const remarkCountByZone = useMemo(() => {
    const m = {};
    zonedRemarks.forEach(r => { if (r.zone_id) m[r.zone_id] = (m[r.zone_id] || 0) + 1; });
    return m;
  }, [zonedRemarks]);

  // Average urgency per zone
  const avgUrgencyByZone = useMemo(() => {
    const sums = {}, counts = {};
    zonedRemarks.forEach(r => {
      if (r.zone_id) {
        sums[r.zone_id] = (sums[r.zone_id] || 0) + (r.urgency || 1);
        counts[r.zone_id] = (counts[r.zone_id] || 0) + 1;
      }
    });
    const avgs = {};
    Object.keys(sums).forEach(zid => { avgs[zid] = (sums[zid] / counts[zid]).toFixed(1); });
    return avgs;
  }, [zonedRemarks]);

  // Sort zones by average urgency (highest = most critical first)
  const sortedZones = useMemo(() =>
    [...uniqueZones].sort((a, b) =>
      parseFloat(avgUrgencyByZone[b.id] || 0) - parseFloat(avgUrgencyByZone[a.id] || 0)
    ),
    [uniqueZones, avgUrgencyByZone]
  );

  // Map-visible remarks (with valid coordinates, inside zones)
  const visibleRemarks = useMemo(() =>
    zonedRemarks.filter(r => r.latitude && r.longitude),
    [zonedRemarks]
  );

  // Quick summary strip numbers
  const summaryStats = useMemo(() => {
    const totalVisible = visibleRemarks.length;
    const zonesDisplayed = uniqueZones.length;
    const globalAvgUrg = totalVisible > 0
      ? (visibleRemarks.reduce((s, r) => s + (r.urgency || 1), 0) / totalVisible).toFixed(1)
      : '0.0';
    return { totalVisible, zonesDisplayed, globalAvgUrg };
  }, [visibleRemarks, uniqueZones]);

  // Selected-zone detail computations
  const selectedZoneRemarks = useMemo(() => {
    if (!selectedZone) return [];
    return zonedRemarks.filter(r => r.zone_id === selectedZone.id);
  }, [selectedZone, zonedRemarks]);

  const monthLabels = useMemo(() => getMonthLabels(), []);

  // ── Handlers ─────────────────────────────────────────────────────────────

  const handleSelectZone = useCallback((zone) => {
    setPanelLoading(true);
    setSelectedZone(zone);
    setContextZone(zone);
    if (zone && isValidCoords(zone.coordonnees_geojson)) {
      const center = getCenter(zone.coordonnees_geojson);
      if (mapRef.current) mapRef.current.flyTo(center, 14, { duration: 0.8 });
    }
    setTimeout(() => setPanelLoading(false), 400);
  }, [setContextZone]);

  const handleAnalyzeZone = useCallback((zone) => {
    setContextZone(zone);
    if (onSwitchTab) onSwitchTab('statistiques');
  }, [setContextZone, onSwitchTab]);

  const handleClearZone = useCallback(() => {
    setSelectedZone(null);
    setContextZone(null);
    setActiveCatFilter(null);
    if (mapRef.current) mapRef.current.flyTo(initialCenter, initialZoom, { duration: 0.8 });
  }, [setContextZone, initialCenter, initialZoom]);

  const handleDropdownZoneChange = useCallback((e) => {
    const val = e.target.value;
    if (!val) { handleClearZone(); return; }
    const zoneId = parseInt(val, 10);
    const zone = uniqueZones.find(z => z.id === zoneId);
    if (zone) handleSelectZone(zone);
  }, [uniqueZones, handleSelectZone, handleClearZone]);

  const toggleCatFilter = useCallback((cat) => {
    setActiveCatFilter(prev => prev === cat ? null : cat);
  }, []);

  // ── Loading state ────────────────────────────────────────────────────────

  if (loading) {
    return <div style={{ padding: 24 }}><SkeletonTable rows={8} columns={3} /></div>;
  }

  // ══════════════════════════════════════════════════════════════════════════
  // RENDER
  // ══════════════════════════════════════════════════════════════════════════

  return (
    <div style={{ fontFamily: "'DM Sans', sans-serif", color: '#F2EDE6' }}>

      {/* ── Main layout: map + sidebar ────────────────────────────────────── */}
      <div style={{
        display: 'flex',
        flexDirection: isMobile ? 'column' : 'row',
        gap: 14,
      }}>

        {/* ═══════════ MAP PANEL ═══════════ */}
        <div style={{
          flex: 1, minWidth: 0,
          background: 'rgba(255,255,255,0.02)',
          border: '0.5px solid rgba(242,237,230,0.07)',
          borderRadius: 10,
          overflow: 'hidden',
          position: 'relative',
        }}>

          {/* Toolbar */}
          <div style={{
            padding: '10px 14px',
            display: 'flex', alignItems: 'center', justifyContent: 'space-between',
            borderBottom: '0.5px solid rgba(242,237,230,0.06)',
          }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: 14 }}>
              <span style={{
                fontSize: 11, color: 'rgba(242,237,230,0.4)',
                display: 'flex', alignItems: 'center', gap: 6,
              }}>
                <span style={{
                  width: 5, height: 5, borderRadius: '50%',
                  background: '#22c55e', display: 'inline-block',
                }} />
                Carte analytique des signalements · {user?.city
                  ? user.city.charAt(0).toUpperCase() + user.city.slice(1)
                  : 'Maroc'}
              </span>

              <button
                onClick={() => setHeatmapOn(!heatmapOn)}
                style={{
                  background: heatmapOn ? 'rgba(193,68,14,0.15)' : 'rgba(255,255,255,0.03)',
                  border: `0.5px solid ${heatmapOn ? '#C1440E' : 'rgba(242,237,230,0.1)'}`,
                  color: heatmapOn ? '#C1440E' : 'rgba(242,237,230,0.4)',
                  padding: '4px 8px', borderRadius: '4px',
                  fontSize: '10px', cursor: 'pointer',
                  display: 'flex', alignItems: 'center', gap: '4px',
                  fontFamily: 'DM Sans, sans-serif',
                }}
              >
                🔥 Thermique
              </button>
            </div>

            {/* Layer legend pills */}
            <div style={{ display: 'flex', gap: 8, alignItems: 'center' }}>
              {[
                { color: '#ef4444', label: 'Critique' },
                { color: '#f59e0b', label: 'Modéré' },
                { color: '#22c55e', label: 'Calme' },
              ].map(l => (
                <span key={l.label} style={{
                  display: 'flex', alignItems: 'center', gap: 4,
                  fontSize: 10, color: 'rgba(242,237,230,0.35)',
                }}>
                  <span style={{
                    width: 6, height: 6, borderRadius: '50%',
                    background: l.color, display: 'inline-block',
                  }} />
                  {l.label}
                </span>
              ))}
            </div>
          </div>

          {/* Map container */}
          <div style={{ height: isMobile ? 320 : 'calc(100vh - 160px)', position: 'relative' }}>
            <MapContainer
              center={initialCenter}
              zoom={initialZoom}
              minZoom={cityMinZoom}
              maxBounds={cityBounds}
              maxBoundsViscosity={1.0}
              zoomControl={false}
              style={{ width: '100%', height: '100%', zIndex: 1 }}
              scrollWheelZoom={true}
              ref={mapRef}
            >
              <InvalidateSize />
              <MapController center={initialCenter} zoom={initialZoom} bounds={cityBounds} minZoom={cityMinZoom} />

              <TileLayer
                url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
                attribution='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
              />

              {/* Zone-filtered heatmap — only inside official zones */}
              {heatmapOn && (
                <UrbanHeatmapLayer zones={uniqueZones} remarks={visibleRemarks} />
              )}

              {/* Zone polygons */}
              {uniqueZones.map(zone => (
                <ZonePolygon
                  key={zone.id}
                  zone={zone}
                  remarkCount={remarkCountByZone[zone.id] || 0}
                  avgUrgency={avgUrgencyByZone[zone.id] || '0.0'}
                  isSelected={selectedZone ? selectedZone.id === zone.id : null}
                  heatmapOn={heatmapOn}
                  onClick={handleSelectZone}
                  onAnalyze={handleAnalyzeZone}
                />
              ))}

              {/* Report dots — ONLY inside official zones */}
              {visibleRemarks.map((r, i) => {
                const cat = (r.categorie || r.category || 'autre').toLowerCase().trim();
                const isFiltered = activeCatFilter && cat !== activeCatFilter;
                return (
                  <CircleMarker
                    key={i}
                    center={[parseFloat(r.latitude), parseFloat(r.longitude)]}
                    radius={heatmapOn ? 8 : 5}
                    pathOptions={{
                      color: 'transparent',
                      fillColor: getCatColor(cat),
                      fillOpacity: isFiltered ? 0.1 : (heatmapOn ? 0.75 : 0.85),
                    }}
                  >
                    <Tooltip direction="top" sticky>
                      <div style={{ fontSize: '11px', fontWeight: 600, color: '#060403', textTransform: 'capitalize' }}>
                        {r.categorie || r.category || 'Autre'}
                      </div>
                      <div style={{ fontSize: '10px', color: '#374151' }}>
                        Urgence {r.urgency || 1}/5
                      </div>
                    </Tooltip>
                  </CircleMarker>
                );
              })}

              {/* Floating zoom controls */}
              <div style={{
                position: 'absolute',
                bottom: '60px',
                right: '12px',
                display: 'flex',
                flexDirection: 'column',
                gap: '4px',
                zIndex: 999,
              }}>
                {['+', '−'].map((icon, i) => (
                  <button
                    key={i}
                    onClick={() => {
                      const map = mapRef.current;
                      if (!map) return;
                      i === 0 ? map.zoomIn() : map.zoomOut();
                    }}
                    style={{
                      width: '36px', height: '36px',
                      background: 'rgba(6,4,3,0.88)',
                      border: '0.5px solid rgba(242,237,230,0.12)',
                      borderRadius: '8px', color: '#F2EDE6',
                      fontSize: '18px', cursor: 'pointer',
                      display: 'flex', alignItems: 'center', justifyContent: 'center',
                      fontFamily: 'DM Sans, sans-serif',
                    }}
                  >
                    {icon}
                  </button>
                ))}
              </div>
            </MapContainer>
          </div>

          {/* Bottom density legend bar */}
          <div style={{
            padding: '8px 14px',
            borderTop: '0.5px solid rgba(242,237,230,0.06)',
            display: 'flex', alignItems: 'center', gap: 8,
          }}>
            <span style={{ fontSize: 9, color: 'rgba(242,237,230,0.25)', whiteSpace: 'nowrap', fontWeight: 500, letterSpacing: '0.06em', textTransform: 'uppercase' }}>Densité</span>
            <span style={{ fontSize: 9, color: 'rgba(242,237,230,0.25)', fontFamily: 'DM Mono, monospace' }}>Faible</span>
            <div style={{
              flex: 1, height: 4, borderRadius: 3,
              background: 'linear-gradient(90deg, rgba(34,197,94,0.7) 0%, rgba(245,158,11,0.8) 50%, rgba(239,68,68,1) 100%)',
            }} />
            <span style={{ fontSize: 9, color: 'rgba(242,237,230,0.25)', fontFamily: 'DM Mono, monospace' }}>Élevée</span>
          </div>
        </div>

        {/* ═══════════ SIDE PANEL ═══════════ */}
        <aside style={{
          width: isMobile ? '100%' : 300,
          flexShrink: 0,
          display: 'flex', flexDirection: 'column', gap: 10,
          boxSizing: 'border-box',
        }}>

          {selectedZone ? (
            /* ── Zone Selected State ─────────────────────────────────────── */
            panelLoading ? (
              <ZonePanelSkeleton />
            ) : (
              <div style={{ padding: '16px', display: 'flex', flexDirection: 'column', gap: '12px', animation: 'ucFadeIn 0.3s ease' }}>
                <style>{`@keyframes ucFadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}`}</style>

                {/* Header */}
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                  <div>
                    <div style={{ fontSize: '9px', letterSpacing: '0.1em', textTransform: 'uppercase', color: 'rgba(242,237,230,0.3)', marginBottom: '4px' }}>Zone sélectionnée</div>
                    <div style={{ fontSize: '15px', fontWeight: 600, color: '#F2EDE6' }}>{selectedZone.nom}</div>
                  </div>
                  <button
                    onClick={handleClearZone}
                    style={{ background: 'transparent', border: 'none', color: 'rgba(242,237,230,0.3)', fontSize: '16px', cursor: 'pointer' }}
                  >✕</button>
                </div>

                {/* Severity badge */}
                {(() => {
                  const zoneRemarks = remarks.filter(r => r.zone_id === selectedZone.id);
                  const count = zoneRemarks.length;
                  const level = count >= 6 ? 'Critique' : count >= 3 ? 'Modéré' : 'Calme';
                  const color = count >= 6 ? '#ef4444' : count >= 3 ? '#f59e0b' : '#22c55e';
                  return (
                    <div style={{ display: 'inline-flex', alignItems: 'center', gap: '5px', background: `${color}18`, border: `0.5px solid ${color}40`, borderRadius: '20px', padding: '3px 10px', width: 'fit-content' }}>
                      <span style={{ width: '5px', height: '5px', borderRadius: '50%', background: color, display: 'inline-block' }} />
                      <span style={{ fontSize: '10px', color, fontWeight: 600 }}>{level}</span>
                    </div>
                  );
                })()}

                {/* KPI cards */}
                {(() => {
                  const zoneRemarks = remarks.filter(r => r.zone_id === selectedZone.id);
                  const urgencyAvg = zoneRemarks.length
                    ? (zoneRemarks.reduce((s, r) => s + (r.urgency || 1), 0) / zoneRemarks.length).toFixed(1)
                    : '0.0';
                  return (
                    <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px' }}>
                      {[
                        { label: 'Signalements', value: zoneRemarks.length, color: '#C1440E' },
                        { label: 'Urgence moy.', value: `${urgencyAvg}/5`, color: '#E8B87A' },
                      ].map((k, i) => (
                        <div key={i} style={{ background: 'rgba(255,255,255,0.03)', border: '0.5px solid rgba(242,237,230,0.07)', borderRadius: '8px', padding: '10px 12px', position: 'relative', overflow: 'hidden' }}>
                          <div style={{ position: 'absolute', top: 0, left: 0, right: 0, height: '1.5px', background: k.color }} />
                          <div style={{ fontSize: '9px', color: 'rgba(242,237,230,0.3)', textTransform: 'uppercase', letterSpacing: '0.06em', marginBottom: '4px' }}>{k.label}</div>
                          <div style={{ fontSize: '20px', fontWeight: 600, color: '#E8B87A', fontVariantNumeric: 'tabular-nums' }}>{k.value}</div>
                        </div>
                      ))}
                    </div>
                  );
                })()}

                {/* Category breakdown */}
                {(() => {
                  const zoneRemarks = remarks.filter(r => r.zone_id === selectedZone.id);
                  const catMap = {};
                  zoneRemarks.forEach(r => {
                    const cat = r.categorie?.toLowerCase() || 'autre';
                    catMap[cat] = (catMap[cat] || 0) + 1;
                  });
                  const cats = Object.entries(catMap).sort((a, b) => b[1] - a[1]);
                  if (!cats.length) return null;
                  return (
                    <div style={{ background: 'rgba(255,255,255,0.02)', border: '0.5px solid rgba(242,237,230,0.07)', borderRadius: '8px', padding: '12px' }}>
                      <div style={{ fontSize: '9px', color: 'rgba(242,237,230,0.3)', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: '10px' }}>Par catégorie</div>
                      {cats.map(([cat, count]) => {
                        const pct = Math.round((count / zoneRemarks.length) * 100);
                        const color = getCatColor(cat);
                        return (
                          <div key={cat} style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '7px' }}>
                            <span style={{ fontSize: '10px', color: 'rgba(242,237,230,0.4)', width: '60px', flexShrink: 0, textTransform: 'capitalize' }}>{CAT_LABEL[cat] || cat}</span>
                            <div style={{ flex: 1, height: '3px', background: 'rgba(255,255,255,0.05)', borderRadius: '2px' }}>
                              <div style={{ height: '100%', width: `${pct}%`, background: color, borderRadius: '2px' }} />
                            </div>
                            <span style={{ fontSize: '10px', color: 'rgba(242,237,230,0.3)', width: '28px', textAlign: 'right', fontVariantNumeric: 'tabular-nums' }}>{pct}%</span>
                          </div>
                        );
                      })}
                    </div>
                  );
                })()}

                {/* 3-month trend */}
                {(() => {
                  const trend = getMonthlyTrend(selectedZone.id, remarks);
                  const max = Math.max(...trend, 1);
                  const now = new Date();
                  const labels = [2, 1, 0].map(i => {
                    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                    return d.toLocaleString('fr-FR', { month: 'short' });
                  });
                  return (
                    <div style={{ background: 'rgba(255,255,255,0.02)', border: '0.5px solid rgba(242,237,230,0.07)', borderRadius: '8px', padding: '12px' }}>
                      <div style={{ fontSize: '9px', color: 'rgba(242,237,230,0.3)', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: '10px' }}>Tendance 3 mois</div>
                      <div style={{ display: 'flex', alignItems: 'flex-end', gap: '8px', height: '48px' }}>
                        {trend.map((val, i) => (
                          <div key={i} style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '4px', height: '100%', justifyContent: 'flex-end' }}>
                            <div style={{ width: '100%', background: '#C1440E', borderRadius: '3px 3px 0 0', height: `${Math.round((val / max) * 36) + 4}px`, opacity: i === 2 ? 1 : 0.5 }} />
                            <span style={{ fontSize: '9px', color: 'rgba(242,237,230,0.3)' }}>{labels[i]}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  );
                })()}

                {/* AI insight */}
                {(() => {
                  const zoneRemarks = remarks.filter(r => r.zone_id === selectedZone.id);
                  if (!zoneRemarks.length) return (
                    <div style={{ background: 'rgba(193,68,14,0.05)', border: '0.5px solid rgba(193,68,14,0.15)', borderRadius: '8px', padding: '12px' }}>
                      <div style={{ fontSize: '9px', color: '#C1440E', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: '6px' }}>Analyse</div>
                      <p style={{ fontSize: '11px', color: 'rgba(242,237,230,0.45)', lineHeight: 1.6, margin: 0, fontStyle: 'italic' }}>Aucun signalement pour cette zone.</p>
                    </div>
                  );
                  const catMap = {};
                  zoneRemarks.forEach(r => { const c = r.categorie?.toLowerCase() || 'autre'; catMap[c] = (catMap[c] || 0) + 1; });
                  const dominant = Object.entries(catMap).sort((a, b) => b[1] - a[1])[0];
                  const pct = Math.round((dominant[1] / zoneRemarks.length) * 100);
                  const urgentCount = zoneRemarks.filter(r => (r.urgency || 1) >= 4).length;
                  const msg = `${pct}% des signalements concernent ${CAT_LABEL[dominant[0]] || dominant[0]} dans cette zone.${urgentCount >= 3 ? ' Intervention recommandée.' : ''}`;
                  return (
                    <div style={{ background: 'rgba(193,68,14,0.05)', border: '0.5px solid rgba(193,68,14,0.15)', borderRadius: '8px', padding: '12px' }}>
                      <div style={{ fontSize: '9px', color: '#C1440E', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: '6px' }}>Analyse IA</div>
                      <p style={{ fontSize: '11px', color: 'rgba(242,237,230,0.45)', lineHeight: 1.6, margin: 0, fontStyle: 'italic' }}>{msg}</p>
                    </div>
                  );
                })()}

                {/* Voir statistiques complètes button */}
                <button
                  onClick={() => handleAnalyzeZone(selectedZone)}
                  style={{
                    width: '100%', padding: '10px 14px', borderRadius: '8px',
                    background: 'rgba(193,68,14,0.1)',
                    border: '0.5px solid rgba(193,68,14,0.3)',
                    color: '#E8B87A', fontSize: '12px', fontWeight: 600,
                    cursor: 'pointer', fontFamily: 'DM Sans, sans-serif',
                    transition: 'all 0.2s',
                    display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '6px',
                  }}
                  onMouseEnter={e => { e.currentTarget.style.background = 'rgba(193,68,14,0.2)'; e.currentTarget.style.color = '#F2EDE6'; }}
                  onMouseLeave={e => { e.currentTarget.style.background = 'rgba(193,68,14,0.1)'; e.currentTarget.style.color = '#E8B87A'; }}
                >
                  📊 Voir statistiques complètes →
                </button>

              </div>
            )
          ) : (
            /* ── Default State (no zone selected) ────────────────────────── */
            <>
              {/* 1 — Zone selector dropdown */}
              <div style={{
                background: 'rgba(255,255,255,0.03)',
                border: '0.5px solid rgba(242,237,230,0.07)',
                borderRadius: 8, padding: 12,
              }}>
                <div style={{
                  fontSize: 9, color: 'rgba(242,237,230,0.3)',
                  textTransform: 'uppercase', letterSpacing: '0.08em',
                  marginBottom: 8, fontWeight: 600,
                }}>
                  Zone d'analyse
                </div>
                <select
                  value={selectedZone?.id || ''}
                  onChange={handleDropdownZoneChange}
                  style={{
                    width: '100%', padding: '7px 10px',
                    background: 'rgba(255,255,255,0.04)',
                    border: '0.5px solid rgba(242,237,230,0.12)',
                    borderRadius: 6, color: '#F2EDE6', fontSize: 12,
                    fontFamily: 'DM Sans, sans-serif', outline: 'none', cursor: 'pointer',
                  }}
                >
                  <option value="" style={{ background: '#0f0c09' }}>Toutes les zones</option>
                  {uniqueZones.map(z => (
                    <option key={z.id} value={z.id} style={{ background: '#0f0c09' }}>{z.nom}</option>
                  ))}
                </select>
                <div style={{ fontSize: 10, color: 'rgba(242,237,230,0.25)', marginTop: 8, lineHeight: 1.5 }}>
                  Sélectionnez une zone ou cliquez sur la carte.
                </div>
              </div>

              {/* Active filter indicator */}
              {activeCatFilter && (
                <div style={{
                  display: 'flex', alignItems: 'center', justifyContent: 'space-between',
                  background: 'rgba(193,68,14,0.08)',
                  border: '0.5px solid rgba(193,68,14,0.2)',
                  borderRadius: 6, padding: '7px 10px',
                  fontSize: 11, color: '#E8B87A',
                }}>
                  <span>
                    Filtré : <strong>{CAT_LABEL[activeCatFilter] || activeCatFilter}</strong> uniquement
                  </span>
                  <button
                    onClick={() => setActiveCatFilter(null)}
                    style={{
                      background: 'none', border: 'none',
                      color: 'rgba(242,237,230,0.4)', cursor: 'pointer',
                      fontSize: 12, padding: '0 2px',
                      fontFamily: 'DM Sans, sans-serif',
                    }}
                  >✕</button>
                </div>
              )}

              {/* 2 — Category legend (clickable to filter) */}
              <div style={{
                background: 'rgba(255,255,255,0.02)',
                border: '0.5px solid rgba(242,237,230,0.07)',
                borderRadius: '8px', padding: '12px 14px',
              }}>
                <div style={{
                  fontSize: '9px', color: 'rgba(242,237,230,0.3)',
                  textTransform: 'uppercase', letterSpacing: '0.08em',
                  marginBottom: '10px', fontWeight: 600,
                }}>
                  Légende catégories
                </div>

                {Object.keys(categoryColors).length === 0 ? (
                  <div style={{ fontSize: '11px', color: 'rgba(242,237,230,0.25)', fontStyle: 'italic' }}>
                    Aucune donnée de catégorie disponible
                  </div>
                ) : (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: '3px' }}>
                    {Object.entries(categoryColors).map(([cat, color]) => {
                      const isActive = activeCatFilter === cat;
                      const isDimmed = activeCatFilter && !isActive;
                      return (
                        <button
                          key={cat}
                          onClick={() => toggleCatFilter(cat)}
                          style={{
                            display: 'flex', alignItems: 'center', gap: '8px',
                            background: isActive ? 'rgba(193,68,14,0.1)' : 'transparent',
                            border: isActive ? '0.5px solid rgba(193,68,14,0.3)' : '0.5px solid transparent',
                            borderRadius: 4, padding: '4px 6px',
                            cursor: 'pointer', transition: 'all 0.15s',
                            width: '100%', textAlign: 'left',
                            fontFamily: 'DM Sans, sans-serif',
                          }}
                          onMouseEnter={e => {
                            if (!isActive) e.currentTarget.style.background = 'rgba(255,255,255,0.04)';
                          }}
                          onMouseLeave={e => {
                            if (!isActive) e.currentTarget.style.background = 'transparent';
                          }}
                        >
                          <span style={{
                            width: 8, height: 8, borderRadius: '50%',
                            background: color, flexShrink: 0,
                            opacity: isDimmed ? 0.3 : 1,
                            transition: 'opacity 0.2s',
                          }} />
                          <span style={{
                            fontSize: '11px',
                            color: isDimmed ? 'rgba(242,237,230,0.2)' : 'rgba(242,237,230,0.55)',
                            textTransform: 'capitalize',
                            transition: 'color 0.2s',
                          }}>
                            {CAT_LABEL[cat] || cat}
                          </span>
                        </button>
                      );
                    })}
                  </div>
                )}
              </div>

              {/* 3 — Zones par urgence moyenne */}
              <div style={{
                background: 'rgba(255,255,255,0.02)',
                border: '0.5px solid rgba(242,237,230,0.07)',
                borderRadius: 8, padding: 12,
                flex: 1, overflow: 'hidden',
                display: 'flex', flexDirection: 'column',
              }}>
                <div style={{ fontSize: 10, color: 'rgba(242,237,230,0.3)', letterSpacing: '0.06em', textTransform: 'uppercase', marginBottom: 10, fontWeight: 600 }}>
                  🔥 Zones par urgence moyenne
                </div>

                <div style={{
                  flex: 1, overflowY: 'auto',
                  maxHeight: isMobile ? 'none' : 260,
                  scrollbarWidth: 'thin',
                  scrollbarColor: 'rgba(242,237,230,0.08) transparent',
                  display: 'flex', flexDirection: 'column', gap: 6,
                }}>
                  {sortedZones.length === 0 ? (
                    <div style={{ fontSize: 11, color: 'rgba(242,237,230,0.25)', textAlign: 'center', padding: 20 }}>
                      Aucune zone créée pour cette ville
                    </div>
                  ) : (
                    sortedZones.map(zone => {
                      const count = remarkCountByZone[zone.id] || 0;
                      const avg = parseFloat(avgUrgencyByZone[zone.id] || 0);
                      const urgColor = getUrgencyColor(avg);
                      const urgLabel = getUrgencyLabel(avg);

                      return (
                        <div
                          key={zone.id}
                          onClick={() => handleSelectZone(zone)}
                          style={{
                            background: 'rgba(255,255,255,0.02)',
                            border: '0.5px solid rgba(242,237,230,0.06)',
                            borderRadius: 8, padding: '10px 12px',
                            cursor: 'pointer', transition: 'all 0.2s',
                          }}
                          onMouseEnter={e => { e.currentTarget.style.background = 'rgba(255,255,255,0.06)'; e.currentTarget.style.borderColor = 'rgba(242,237,230,0.12)'; }}
                          onMouseLeave={e => { e.currentTarget.style.background = 'rgba(255,255,255,0.02)'; e.currentTarget.style.borderColor = 'rgba(242,237,230,0.06)'; }}
                        >
                          {/* Zone name + urgency badge */}
                          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 6 }}>
                            <div style={{ fontSize: 12, fontWeight: 600, color: '#F2EDE6', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', flex: 1, marginRight: 8 }}>
                              {zone.nom}
                            </div>
                            <span style={{
                              padding: '2px 8px', borderRadius: 100, fontSize: 9, fontWeight: 600,
                              background: `${urgColor}18`, color: urgColor,
                              border: `0.5px solid ${urgColor}40`, flexShrink: 0,
                            }}>
                              {urgLabel}
                            </span>
                          </div>
                          {/* Count + Analyser button */}
                          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                            <span style={{ fontSize: 10, color: 'rgba(242,237,230,0.35)', fontVariantNumeric: 'tabular-nums' }}>
                              {count} signalement{count !== 1 ? 's' : ''}
                            </span>
                            <button
                              onClick={e => { e.stopPropagation(); handleAnalyzeZone(zone); }}
                              style={{
                                background: 'none', border: 'none',
                                color: '#C1440E', fontSize: 10, fontWeight: 600,
                                cursor: 'pointer', padding: '2px 0',
                                fontFamily: 'DM Sans, sans-serif',
                                transition: 'color 0.2s',
                              }}
                              onMouseEnter={e => e.currentTarget.style.color = '#E8B87A'}
                              onMouseLeave={e => e.currentTarget.style.color = '#C1440E'}
                            >
                              Analyser →
                            </button>
                          </div>
                        </div>
                      );
                    })
                  )}
                </div>
              </div>

              {/* 4 — Quick summary strip */}
              <div style={{
                display: 'grid', gridTemplateColumns: '1fr 1fr 1fr',
                gap: 4,
                background: 'rgba(255,255,255,0.02)',
                border: '0.5px solid rgba(242,237,230,0.07)',
                borderRadius: 8, padding: '10px 8px',
              }}>
                {[
                  { label: 'Signalements', value: summaryStats.totalVisible },
                  { label: 'Zones', value: summaryStats.zonesDisplayed },
                  { label: 'Urg. moy.', value: summaryStats.globalAvgUrg },
                ].map((item, i) => (
                  <div key={i} style={{ textAlign: 'center' }}>
                    <div style={{
                      fontSize: 16, fontWeight: 600, color: '#E8B87A',
                      fontFamily: 'DM Mono, monospace', lineHeight: 1,
                    }}>
                      {item.value}
                    </div>
                    <div style={{
                      fontSize: 8, color: 'rgba(242,237,230,0.25)',
                      textTransform: 'uppercase', letterSpacing: '0.06em', marginTop: 3,
                    }}>
                      {item.label}
                    </div>
                  </div>
                ))}
              </div>
            </>
          )}
        </aside>
      </div>
    </div>
  );
}
